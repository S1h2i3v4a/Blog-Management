<%- include('layout/header') -%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= post.title %></title>

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body { background-color: #f8f9fa; }
    .post-img { max-height: 420px; object-fit: cover; }
    .tag {
      background: #eef2ff;
      color: #4f46e5;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 13px;
      margin-right: 6px;
    }
    .comment-box {
      background: #fff;
      border-radius: 12px;
    }
  </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">MyBlog</a>
  </div>
</nav>

<!-- POST -->
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card shadow border-0 mb-4">
        <% if (post.imageUrl && post.imageUrl.trim() !== "") { %>
          <img src="<%= post.imageUrl %>" class="card-img-top post-img">
        <% } %>

        <div class="card-body p-4">
          <h1 class="fw-bold mb-2"><%= post.title %></h1>

          <div class="mb-3">
            <% if (post.tags?.length) { %>
              <% post.tags.forEach(tag => { %>
                <span class="tag">#<%= tag %></span>
              <% }) %>
            <% } else { %>
              <span class="tag">#general</span>
            <% } %>
          </div>

          <p class="text-muted mb-4">
            <i class="bi bi-calendar3"></i>
            <%= post.createdAt.toDateString() %>
          </p>

          <p class="fs-5" style="line-height:1.8">
            <%= post.content %>
          </p>
        </div>
      </div>

      <!-- COMMENTS -->
      <div class="comment-box p-4 shadow-sm mb-5">
        <h4 class="mb-4">
          <i class="bi bi-chat-dots"></i> Comments
        </h4>

        <div id="commentList">

          <% post.comments?.forEach(c => { %>
            <div class="mb-3 border-bottom pb-2" data-comment-id="<%= c._id %>">
              <strong><%= c.name || "Anonymous" %></strong>
              <p class="mb-1 text-muted"><%= c.text %></p>

              <div class="d-flex gap-2 align-items-center mb-2">
                <button class="btn btn-sm btn-outline-success comment-like" data-post-id="<%= post._id %>" data-comment-id="<%= c._id %>">
                  👍 <span class="comment-like-count"><%= c.likes || 0 %></span>
                </button>
                <button class="btn btn-sm btn-outline-danger comment-dislike" data-post-id="<%= post._id %>" data-comment-id="<%= c._id %>">
                  👎 <span class="comment-dislike-count"><%= c.dislikes || 0 %></span>
                </button>
              </div>

              <!-- Reply Form -->
              <form action="/do-reply" method="POST" class="replyForm mt-2">
                <input type="hidden" name="postId" value="<%= post._id %>">
                <input type="hidden" name="commentId" value="<%= c._id %>">

                <input type="text" class="form-control form-control-sm mb-2"
                       name="name" placeholder="Your name (optional)">

                <input class="form-control form-control-sm mb-2"
                       name="reply" placeholder="Write a reply..." required>

                <button class="btn btn-sm btn-outline-primary">Reply</button>
              </form>

              <!-- Replies -->
              <% if (c.replies && c.replies.length > 0) { %>
                <% c.replies.forEach(r => { %>
                  <div class="ms-4 mt-3 p-2 bg-light rounded">
                    <strong><%= r.name || "Anonymous" %></strong>
                    <p class="mb-1 text-muted"><%= r.text %></p>
                  </div>
                <% }) %>
              <% } %>

            </div>
          <% }) %>

        </div>

        <hr>

        <!-- Add Comment -->
        <form id="commentForm" action="/post/<%= post._id %>" method="POST">
          <div class="mb-3">
            <label>Name</label>
            <input class="form-control" name="name" required>

            <label>E-mail</label>
            <input type="email" class="form-control" name="email" required>

            <label class="mt-2">Your Comment</label>
            <textarea class="form-control" rows="3" name="comment" required></textarea>
          </div>

          <button class="btn btn-primary">
            <i class="bi bi-send"></i> Add Comment
          </button>
        </form>

      </div>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  const commentForm = document.getElementById("commentForm");
  const commentList = document.getElementById("commentList");

/* COMMENT AJAX */
commentForm.addEventListener("submit", async (e) => {
  e.preventDefault();

  const name = commentForm.name.value.trim();
  const comment = commentForm.comment.value.trim();
  const email = commentForm.email.value.trim(); 

  if (!name || !comment || !email) return;

  const res = await fetch(commentForm.action, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ name, comment, email })
  });

  const data = await res.json();

  if (data.success) {

    const div = document.createElement("div");
    div.className = "mb-3 border-bottom pb-2";

    div.innerHTML = `
      <strong>${data.name}</strong>
      <p class="mb-1 text-muted">${data.comment}</p>

      <form action="/do-reply" method="POST" class="replyForm mt-2">
        <input type="hidden" name="postId" value="${data.postId}">
        <input type="hidden" name="commentId" value="${data.commentId}">

        <input type="text" class="form-control form-control-sm mb-2"
               name="name" placeholder="Your name (optional)">

        <input class="form-control form-control-sm mb-2"
               name="reply" placeholder="Write a reply..." required>

        <button class="btn btn-sm btn-outline-primary">Reply</button>
      </form>
    `;

    commentList.appendChild(div);
    commentForm.reset();

    attachReplyListener(div.querySelector(".replyForm"));
  }
});

/* REPLY FUNCTION */
function attachReplyListener(form) {
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const postId = form.postId.value;
    const commentId = form.commentId.value;
    const name = form.name.value.trim();
    const reply = form.reply.value.trim();

    if (!reply) return;

    const res = await fetch(form.action, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ postId, commentId, name, reply })
    });

    const data = await res.json();

    if (data.success) {

      const replyDiv = document.createElement("div");
      replyDiv.className = "ms-4 mt-3 p-2 bg-light rounded";
      replyDiv.innerHTML = `
        <strong>${data.name}</strong>
        <p class="mb-1 text-muted">${data.reply}</p>
      `;

      form.parentElement.appendChild(replyDiv);
      form.reset();
    }
  });
}

/* Existing reply forms */
document.querySelectorAll(".replyForm").forEach(form => {
  attachReplyListener(form);
});

// Like/dislike comment real-time updates
function attachCommentLikeListeners(container) {
  container.addEventListener("click", (event) => {
    const likeBtn = event.target.closest(".comment-like");
    const dislikeBtn = event.target.closest(".comment-dislike");
    if (!likeBtn && !dislikeBtn) return;

    const postId = (likeBtn || dislikeBtn).getAttribute("data-post-id");
    const commentId = (likeBtn || dislikeBtn).getAttribute("data-comment-id");
    const eventName = likeBtn ? "comment:like" : "comment:dislike";

    socket.emit(eventName, { postId, commentId });
  });
}

attachCommentLikeListeners(commentList);

socket.on("comment:updated", (data) => {
  const commentEl = document.querySelector(`[data-comment-id="${data.commentId}"]`);
  if (!commentEl) return;
  const likeCount = commentEl.querySelector(".comment-like-count");
  const dislikeCount = commentEl.querySelector(".comment-dislike-count");
  if (likeCount) likeCount.textContent = data.likes;
  if (dislikeCount) dislikeCount.textContent = data.dislikes;
});

</script>

</body>
</html>
<%- include('layout/footer') -%>