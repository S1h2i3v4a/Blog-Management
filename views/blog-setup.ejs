<%- include('layout/header') -%>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Blog Setup</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="container my-5">
      <h2 class="text-center mb-4">Blog Management System Setup</h2>

      <form action="/blogSetup" method="POST" enctype="multipart/form-data">
        <div class="row">
          <!-- BLOG SETTINGS -->
          <div class="col-md-6">
            <div class="card shadow mb-4">
              <div class="card-header bg-dark text-white">Blog Settings</div>
              <div class="card-body">
                <div class="mb-3">
                  <label>Blog Title</label>
                  <input
                    type="text"
                    name="blog_title"
                    class="form-control"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label>Blog Logo</label>
                  <input
                    type="file"
                    name="blog_logo"
                    class="form-control"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label>Description</label>
                  <textarea
                    name="description"
                    class="form-control"
                    rows="4"
                    required
                  ></textarea>
                </div>
              </div>
            </div>
          </div>

          <!-- ADMIN USER -->
          <div class="col-md-6">
            <div class="card shadow mb-4">
              <div class="card-header bg-secondary text-white">Create User</div>
              <div class="card-body">
                <div class="mb-3">
                  <label>Name</label>
                  <input
                    type="text"
                    name="name"
                    class="form-control"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label>Email</label>
                  <input
                    type="email"
                    name="email"
                    class="form-control"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label>Password</label>
                  <input
                    type="password"
                    name="password"
                    class="form-control"
                    required
                  />
                </div>

                <!-- ROLE -->
                <div class="dropdown mb-3">
                  <button
                    class="btn btn-outline-secondary dropdown-toggle w-100"
                    type="button"
                    data-bs-toggle="dropdown"
                  >
                    Select Role
                  </button>
                  <ul class="dropdown-menu w-100">
                    <li>
                      <a class="dropdown-item" href="#" onclick="setRole(true)"
                        >Admin</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item" href="#" onclick="setRole(false)"
                        >User</a
                      >
                    </li>
                  </ul>
                  <input
                    type="hidden"
                    name="is_admin"
                    id="roleInput"
                    required
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center">
          <button class="btn btn-success px-5">Complete Setup</button>
        </div>
      </form>
    </div>

    <script>
      function setRole(val) {
        document.getElementById("roleInput").value = val;
      }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

<%- include('layout/footer') -%>
